{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/core/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["src/cli/**", "node_modules", "dist", "tests"]
}
